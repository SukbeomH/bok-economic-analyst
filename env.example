# ==============================================================================
# AI 한국은행 경제 분석팀 - 환경 변수 설정
# ==============================================================================
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요.
# cp env.example .env

# 채팅 제공자: openai, claude, openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
# 호환 API 선택 시 필수. 예: http://localhost:8000/v1
LLM_BASE_URL=

# 임베딩 제공자: openai, openai_compatible. Claude와 별도로 설정합니다.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ==============================================================================
# 애플리케이션 설정
# ==============================================================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 데이터 디렉토리
DATA_DIR=data

# 앱 그래프 버전
APP_GRAPH_VERSION=5

# 최대 반복 횟수
MAX_ITERATIONS=10

# 타임아웃 (초)
TIMEOUT_SECONDS=300

# 대화 히스토리 유지 턴 수
MAX_HISTORY_TURNS=6

# ==============================================================================
# RAG (Retrieval-Augmented Generation) 설정
# ==============================================================================
# 검색 전략 (mmr, similarity)
RAG_SEARCH_STRATEGY=mmr

# 검색 결과 수
RAG_K=5

# 가져올 결과 수
RAG_FETCH_K=20

# MMR 람다 값 (0.0 ~ 1.0)
RAG_LAMBDA_MULT=0.7

# 점수 임계값 (0.0 ~ 1.0)
RAG_SCORE_THRESHOLD=0.7

# 압축 사용 여부 (true/false)
RAG_USE_COMPRESSION=false

# ==============================================================================
# KOSIS (통계청) 설정 (선택사항)
# ==============================================================================
# KOSIS 오픈 API 키 (https://kosis.kr/openapi/ 에서 무료 발급)
KOSIS_API_KEY=

# ==============================================================================
# 웹 검색 설정 (선택사항)
# ==============================================================================
# 웹 검색 기능은 기본 검색 엔진을 사용합니다.

# ==============================================================================
# 개발/디버깅 설정
# ==============================================================================
# 디버그 모드 (true/false)
DEBUG_MODE=false

# 캐시 사용 여부 (true/false)
USE_CACHE=true

# 캐시 만료 시간 (초)
CACHE_EXPIRY=3600
